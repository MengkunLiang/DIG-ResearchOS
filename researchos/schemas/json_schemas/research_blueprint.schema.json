{
  "$id": "https://researchos.dev/schemas/research_blueprint.schema.json",
  "type": "object",
  "properties": {
    "semantics": {"const": "t45_research_blueprint"},
    "schema_version": {"type": "string"},
    "orientation": {
      "type": "object",
      "properties": {
        "profile_type": {"enum": ["utd", "ccf_a", "hybrid"]},
        "target_venues": {"type": "array", "items": {"type": "string"}},
        "user_instruction": {"type": "string"},
        "proposal_weights": {"type": "object", "additionalProperties": {"type": "number"}},
        "guidance": {"type": "string", "minLength": 30}
      },
      "required": ["profile_type", "proposal_weights", "guidance"],
      "additionalProperties": true
    },
    "core_problem": {
      "type": "object",
      "properties": {
        "real_world_context": {"type": "string", "minLength": 30},
        "affected_actors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "decision_or_task": {"type": "string", "minLength": 20},
        "observed_failure": {"type": "string", "minLength": 30},
        "scientific_significance": {"type": "string", "minLength": 30}
      },
      "required": ["real_world_context", "affected_actors", "decision_or_task", "observed_failure", "scientific_significance"],
      "additionalProperties": true
    },
    "technical_problem": {
      "type": "object",
      "properties": {
        "computational_abstraction": {"type": "string", "minLength": 30},
        "current_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 15}},
        "failure_mechanisms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 20}},
        "key_challenges": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^C[1-4]$"},
              "existing_assumption": {"type": "string", "minLength": 15},
              "why_it_fails": {"type": "string", "minLength": 20},
              "observable_consequence": {"type": "string", "minLength": 20},
              "required_new_capability": {"type": "string", "minLength": 20}
            },
            "required": ["id", "existing_assumption", "why_it_fails", "observable_consequence", "required_new_capability"],
            "additionalProperties": true
          }
        }
      },
      "required": ["computational_abstraction", "current_assumptions", "failure_mechanisms", "key_challenges"],
      "additionalProperties": true
    },
    "proposed_approach": {
      "type": "object",
      "properties": {
        "artifact_type": {"enum": ["algorithm", "model", "system", "framework", "intervention"]},
        "central_insight": {"type": "string", "minLength": 40},
        "components": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^COMP[1-9][0-9]*$"},
              "name": {"type": "string", "minLength": 3},
              "challenge_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "technical_role": {"type": "string", "minLength": 20},
              "expected_effect": {"type": "string", "minLength": 20}
            },
            "required": ["id", "name", "challenge_refs", "technical_role", "expected_effect"],
            "additionalProperties": true
          }
        },
        "design_rationales": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "component_id": {"type": "string", "pattern": "^COMP[1-9][0-9]*$"},
              "rationale": {"type": "string", "minLength": 30}
            },
            "required": ["component_id", "rationale"],
            "additionalProperties": true
          }
        },
        "alternatives_considered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "alternative": {"type": "string", "minLength": 5},
              "reason_not_sufficient": {"type": "string", "minLength": 20}
            },
            "required": ["alternative", "reason_not_sufficient"],
            "additionalProperties": true
          }
        }
      },
      "required": ["artifact_type", "central_insight", "components", "design_rationales", "alternatives_considered"],
      "additionalProperties": true
    },
    "research_claims": {
      "type": "object",
      "properties": {
        "active_claim_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "cross_level_links": {"type": "array", "items": {"type": "object"}}
      },
      "required": ["active_claim_ids"],
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "datasets_or_setting": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "baselines": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "primary_metrics": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "main_tests": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "ablations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "mechanism_tests": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "robustness_tests": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "efficiency_tests": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "real_world_validation": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "required": ["datasets_or_setting", "baselines", "primary_metrics", "main_tests", "ablations", "mechanism_tests", "robustness_tests", "efficiency_tests", "real_world_validation"],
      "additionalProperties": true
    },
    "contributions": {
      "type": "object",
      "properties": {
        "technical": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "theoretical_or_design": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "practical_or_managerial": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "required": ["technical", "theoretical_or_design", "practical_or_managerial"],
      "additionalProperties": true
    },
    "risks": {
      "type": "object",
      "properties": {
        "novelty_risks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "technical_risks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "data_or_experimental_risks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "fallback_designs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "kill_criteria": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "required": ["novelty_risks", "technical_risks", "data_or_experimental_risks", "fallback_designs", "kill_criteria"],
      "additionalProperties": true
    }
  },
  "required": ["semantics", "orientation", "core_problem", "technical_problem", "proposed_approach", "research_claims", "evaluation", "contributions", "risks"],
  "additionalProperties": true
}
