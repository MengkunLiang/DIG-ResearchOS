{
  "$id": "https://researchos.dev/schemas/claim_registry.schema.json",
  "type": "object",
  "properties": {
    "semantics": {"const": "t45_claim_registry"},
    "schema_version": {"type": "string"},
    "orientation": {"enum": ["utd", "ccf_a", "hybrid"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^(TC|MC|BH|CH|RC|GP|DP)[1-9][0-9]*$"},
          "claim_type": {"enum": ["technical", "algorithmic", "system", "mechanism", "behavioral", "causal", "robustness", "generalization", "design_proposition"]},
          "statement": {"type": "string", "minLength": 25},
          "rationale": {"type": "string", "minLength": 30},
          "related_components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "mechanism": {"type": "string", "minLength": 25},
          "scope_or_boundary_conditions": {"type": "string", "minLength": 20},
          "expected_observation": {"type": "string", "minLength": 20},
          "baseline_or_counterfactual": {"type": "string", "minLength": 20},
          "evaluation_methods": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
          "competing_explanation": {"type": "string", "minLength": 20},
          "falsification_condition": {"type": "string", "minLength": 20},
          "cross_level_relation": {"type": "string"}
        },
        "required": ["id", "claim_type", "statement", "rationale", "related_components", "mechanism", "scope_or_boundary_conditions", "expected_observation", "baseline_or_counterfactual", "evaluation_methods", "competing_explanation", "falsification_condition"],
        "additionalProperties": true
      }
    },
    "dropped_claims": {"type": "array", "items": {"type": "object"}}
  },
  "required": ["semantics", "orientation", "claims"],
  "additionalProperties": true
}
